# ──────────────────────────────────────────────────────────────────────────────
# InsightTrack — PRODUCTION environment template
#
# Copy to `.env` on your server (or set these as platform secrets) and fill in
# every value below. NEVER commit the filled-in file. NEVER reuse the localhost
# defaults from `.env.example` in production.
#
# Generate strong secrets:
#   JWT_SECRET / passwords:   openssl rand -base64 48
#   (or)                      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=insighttrack
POSTGRES_DB=analytics
# REQUIRED: generate with `openssl rand -base64 48`
POSTGRES_PASSWORD=__CHANGE_ME__strong_db_password__

# If your platform injects a single connection string instead, use it and
# leave the discrete PG_* vars unset:
# DATABASE_URL=postgresql://insighttrack:PASSWORD@db-host:5432/analytics

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. The server REFUSES to start in production without this.
# Must be long & random (>= 32 bytes). Generate: openssl rand -base64 48
JWT_SECRET=__CHANGE_ME__at_least_32_random_bytes__
JWT_EXPIRES_IN=7d

# ── CORS — LOCK THIS DOWN ─────────────────────────────────────────────────────
# Comma-separated list of EXACT frontend origins allowed to call the API.
# Production must NOT include localhost. No trailing slashes. Use https://.
CORS_ORIGINS=https://analytics.yourdomain.com

# ── Public URLs ───────────────────────────────────────────────────────────────
# Frontend base URL — used to build team invite links and the demo redirect.
APP_BASE_URL=https://analytics.yourdomain.com

# ── Live demo (optional) ──────────────────────────────────────────────────────
# Domain of the shared demo site the landing-page "Open live dashboard" CTA
# grants viewer access to. Seed it with: node scripts/seed-live-demo.js
DEMO_SITE_DOMAIN=hello.com
# Use a THROWAWAY demo account — never your real admin email/password.
# If you run the seeder without DEMO_PASS it auto-generates a strong one.
# DEMO_EMAIL=demo@yourdomain.com
# DEMO_PASS=__CHANGE_ME__strong_demo_password__

# ── pgAdmin (only if you expose it — prefer NOT to in production) ──────────────
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=__CHANGE_ME__strong_pgadmin_password__

# ── DuckDB / storage ──────────────────────────────────────────────────────────
# Point at a persistent volume so analytics data survives restarts.
DUCKDB_PATH=/data/analytics.duckdb
DUCKDB_POOL_SIZE=4

# ── Sync tuning ───────────────────────────────────────────────────────────────
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=5000
SYNC_DEBOUNCE_MS=5000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ── S3 / R2 / MinIO cold storage (optional — appsv2 hot/cold) ─────────────────
# Leave blank to keep all data on the local DuckDB volume.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_PREFIX=insighttrack
S3_USE_SSL=true
ARCHIVE_DAYS=30
ARCHIVE_TABLES=events,sessions
