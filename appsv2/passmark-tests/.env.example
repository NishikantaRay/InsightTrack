# OpenRouter API key (required) — get yours at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-...

# Base URL for the InsightTrack dashboard under test
# Default: http://localhost:5173 (Vite dev server)
# Set to http://localhost:4173 for preview build
PW_BASE_URL=http://localhost:5173

# API base URL — used by helpers to pre-seed users & sites via REST
API_BASE_URL=http://localhost:3001

# Test credentials (used across all protected-route tests)
# If these don't exist the helpers will auto-register them on first run.
TEST_USER_EMAIL=passmark-tester@insighttrack.local
TEST_USER_PASSWORD=Passmark$ecure123

# Optional: Redis for Passmark step caching (faster re-runs)
# REDIS_URL=redis://localhost:6379
