# Server Configuration
PORT=3001
NODE_ENV=development
SERVER_URL=http://localhost:3001

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_local_postgres_user
PG_PASSWORD=replace_with_your_local_postgres_password
PG_DATABASE=your_local_postgres_database
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# DuckDB file path (relative to apps/analytics-api/)
DUCKDB_PATH=duckdb/analytics.duckdb

# Sync configuration
SYNC_BATCH_SIZE=5000
SYNC_INTERVAL_MS=60000
# Debounce window: after first tracking event, wait this long before syncing PG→DuckDB.
# Higher = fewer syncs = better write throughput at high volume. Lower = faster dashboard refresh.
SYNC_DEBOUNCE_MS=5000

# DuckDB connection pool — parallel analytics queries (increase on 8+ core machines)
DUCKDB_POOL_SIZE=4

# ── S3 / R2 / MinIO cold storage (optional) ─────────────────────────────────
# Leave blank to use local disk only. Set all three to enable S3 archival.
# Compatible with AWS S3, Cloudflare R2, MinIO, and any S3-compatible service.
#
# AWS S3:
#   S3_BUCKET=my-insighttrack-bucket
#   S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#   S3_REGION=us-east-1
#   (leave S3_ENDPOINT blank for AWS S3)
#
# Cloudflare R2 (recommended — zero egress cost):
#   S3_BUCKET=insighttrack-cold
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
# MinIO (self-hosted):
#   S3_BUCKET=insighttrack
#   S3_ACCESS_KEY=minio-access-key
#   S3_SECRET_KEY=minio-secret-key
#   S3_ENDPOINT=http://minio:9000
#   S3_USE_SSL=false

S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PREFIX=insighttrack
S3_USE_SSL=true

# How many days to keep in the hot DuckDB tier before archiving to S3
ARCHIVE_DAYS=30
# Which tables to archive (comma-separated)
ARCHIVE_TABLES=events,sessions

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# JWT (required outside tests; use at least 32 random bytes)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cache TTLs (milliseconds)
CACHE_DEFAULT_TTL_MS=60000
CACHE_CLEANUP_INTERVAL_MS=300000
CACHE_TTL_REALTIME_MS=10000
CACHE_TTL_KPI_MS=30000
CACHE_TTL_TRAFFIC_MS=60000
CACHE_TTL_PAGES_MS=60000
CACHE_TTL_GENERAL_MS=120000

# ── Team & Live Demo ──────────────────────────────────────────────────────────
# Frontend base URL used to build team invite links (must be set in production).
APP_BASE_URL=http://localhost:4173

# Domain of the public demo site that the landing-page "Open live dashboard" CTA
# grants new users viewer access to. Create it with scripts/seed-live-demo.js.
DEMO_SITE_DOMAIN=hello.com

# ── AI Analyst ────
# Server API key per provider (users can also bring their own in Settings → AI).
# Precedence when no user key is set: Anthropic → OpenAI → Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini — uses its OpenAI-compatible endpoint. Get a key at
# aistudio.google.com/apikey. Override the endpoint for Vertex/proxies.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Assistant cost fences (see docs/mcp-improvement-plan.md P0.3, P1.5, N7)
# Per-turn LLM output cap, per-user chat rate limits (msgs/minute), the max
# user/assistant turns of history sent per turn (older turns dropped behind a
# one-line note), and the size cap on tool-result data fed back to the model
# (rows + total chars — large ranges are sampled, not sent whole).
ASSISTANT_MAX_TOKENS=1500
ASSISTANT_RATE_LIMIT_SERVER_KEY=10
ASSISTANT_RATE_LIMIT_OWN_KEY=30
ASSISTANT_MAX_HISTORY_TURNS=20
ASSISTANT_TOOL_MAX_ROWS=100
ASSISTANT_TOOL_MAX_CHARS=20000

# Default model per provider (P3.2) — a per-user override still wins. Set a
# cheaper/faster tier here without a code change.
ASSISTANT_DEFAULT_MODEL_ANTHROPIC=
ASSISTANT_DEFAULT_MODEL_OPENAI=
ASSISTANT_DEFAULT_MODEL_GEMINI=

# MCP connect config command (see routes/mcp.js mcpClientCommand)
# Set MCP_SERVER_PACKAGE once @insighttrack/mcp-server is published to npm;
# or MCP_SERVER_PATH to an absolute local path of mcp-server/src/index.js.
MCP_SERVER_PACKAGE=
MCP_SERVER_PATH=

# MCP toolkit demo endpoints (POST /api/mcp/tools, /sign, /verify) — OFF by
# default. These are engine showcases (arbitrary OpenAPI mapping, in-memory
# replay guard), not product features. Set to 1 only for local experimentation.
MCP_TOOLKIT_DEMOS=

# ── Search visibility / SerpApi connector (optional) ─────────────────────────
# Leave SERPAPI_KEY BLANK to run in fixture mode: the feature serves scrubbed
# sample SERPs from fixtures/serp/ and marks every response source:"fixture".
# The full traffic×SERP correlation demo runs end to end with no key and no
# credits spent. Set the key and the identical code path goes live.
#
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Request timeout in ms
SERPAPI_TIMEOUT_MS=10000
# Hard ceiling on live SerpApi calls per process run — guards against a runaway
# loop draining your credit balance. Raise deliberately.
SERPAPI_MAX_CALLS_PER_RUN=25
# How long an in-memory SERP result is reused (ms). The PostgreSQL snapshot
# cache (serp_snapshots, default 24h) is the layer that actually saves credits.
CACHE_TTL_SERP_MS=900000

# ── Scheduled rank tracking ──────────────────────────────────────────────────
# The traffic×SERP correlation needs a PREVIOUS observation to compare against,
# so positions are recorded on a schedule rather than only when someone opens
# the page. Sites without a SerpApi key are skipped, so this is a no-op until a
# key is configured.
#
# Credit maths matters here. A SerpApi free tier is 100 searches/month, so
# 14 keywords checked daily costs ~420 — over budget. Either raise
# RANK_CHECK_MIN_HOURS, lower RANK_CHECK_MAX_PER_RUN, or track fewer keywords.
#
# NOTE: MIN_HOURS and MAX_PER_RUN below are DEFAULTS only. Each site can now
# override them from the dashboard (Search Visibility → key dialog → budget),
# which shows projected monthly spend against your plan. Stored per site in
# site_integrations.config.rankBudget. See docs/search-visibility-connector.md §14.
#
# How often a sweep runs (ms). Set to 0 to disable tracking entirely.
RANK_CHECK_INTERVAL_MS=21600000
# Minimum age before a keyword is checked again. The real rate limiter — a
# sweep every 6 hours still checks each keyword only once a day at 24.
RANK_CHECK_MIN_HOURS=24
# Hard ceiling on checks per sweep, so a long keyword list cannot spend the
# month's credits in one pass.
RANK_CHECK_MAX_PER_RUN=10
