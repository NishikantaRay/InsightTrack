POSTGRES_USER=trafficuser
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=analytics
PGADMIN_DEFAULT_EMAIL=replace-with-admin-email@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080

# Sync tuning
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=5000

# ── S3 / R2 / MinIO cold storage (optional) ─────────────────────
# Leave all blank to use local Docker volumes only.
# Set S3_BUCKET + S3_ACCESS_KEY + S3_SECRET_KEY to enable cold archival.
#
# Cloudflare R2 example (zero egress cost — recommended):
#   S3_BUCKET=insighttrack-cold
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
# AWS S3 example:
#   S3_BUCKET=my-insighttrack-bucket
#   S3_REGION=us-east-1
#   (leave S3_ENDPOINT blank)
#
# MinIO self-hosted example:
#   S3_ENDPOINT=http://minio:9000
#   S3_USE_SSL=false

S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PREFIX=insighttrack
S3_USE_SSL=true
ARCHIVE_DAYS=30
ARCHIVE_TABLES=events,sessions
