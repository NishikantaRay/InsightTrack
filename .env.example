# ─────────────────────────────────────────────────────────────────
# InsightTrack configuration
#
# Copy to `.env` and edit:   cp .env.example .env
#
# Only the REQUIRED block below must be filled in. Everything else has a
# working default (shown as `# default: X`) and can stay commented out.
# Defaults listed here were read from the source, not assumed.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────
# Postgres credentials. These are consumed by docker-compose to create the
# database; the API reads PG_* below (compose wires them together for you).
POSTGRES_USER=trafficuser
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=analytics

# Signs and verifies JWTs. Use a long random value:
#   openssl rand -base64 48
# Changing this invalidates every existing session. See ENCRYPTION_KEY below
# before rotating it — by default it also protects stored third-party secrets.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# pgAdmin login (only used by the optional `pgadmin` compose service,
# which is published on 127.0.0.1 only).
PGADMIN_DEFAULT_EMAIL=replace-with-admin-email@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password

# Browser origins allowed to call the API. Add your dashboard's real origin
# before deploying; a request from an origin not in this list is rejected.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080

# ── Encryption at rest ───────────────────────────────────────────
# Encrypts third-party credentials stored in the database (e.g. Sentry tokens,
# BYO AI keys). If unset, the key is derived from JWT_SECRET instead — which
# means rotating JWT_SECRET would make already-stored secrets undecryptable.
# Set this explicitly if you store any integration credentials.
#   openssl rand -base64 48
# ENCRYPTION_KEY=

# ── Server ───────────────────────────────────────────────────────
# PORT=3001                       # default: 3001
# NODE_ENV=production             # `production` enables prod-only hardening
# SERVER_URL=http://localhost:3001   # default: http://localhost:3001
#                                 # Baked into the tracking snippet — must be
#                                 # the URL browsers can actually reach.
# APP_BASE_URL=                   # default: empty. Dashboard URL used in emails/links.
# PUBLIC_API_URL=                 # default: empty. Overrides API URL in generated snippets.

# ── PostgreSQL connection (the API's own client) ─────────────────
# In Docker these are set by compose. Set them when running the API directly.
# PG_HOST=localhost               # default: localhost
# PG_PORT=5432                    # default: 5432
# PG_USER=analytics               # default: analytics
# PG_PASSWORD=                    # default: empty
# PG_DATABASE=analytics_db        # default: analytics_db
# PG_POOL_MAX=10                  # default: 10
# PG_CONNECT_TIMEOUT_MS=5000      # default: 5000
# PG_IDLE_TIMEOUT_MS=30000        # default: 30000
# DATABASE_URL=                   # optional single-URL alternative to PG_*

# ── DuckDB (analytics reads) ─────────────────────────────────────
# Path to the DuckDB file. Relative paths resolve inside the API's working
# directory. On ephemeral/serverless hosts point this at a mounted volume —
# otherwise the analytics store is lost on every restart and must resync.
# DUCKDB_PATH=duckdb/analytics.duckdb   # default: duckdb/analytics.duckdb
# DUCKDB_POOL_SIZE=4                    # default: 4 (minimum 1)

# ── Auth & rate limiting ─────────────────────────────────────────
# JWT_EXPIRES_IN=7d               # default: 7d
# RATE_LIMIT_WINDOW_MS=60000      # default: 60000
# RATE_LIMIT_MAX_REQUESTS=1000    # default: 1000 (per window, per IP)

# ── SQL Editor ───────────────────────────────────────────────────
# Query timeouts. A client may request its own timeout but is clamped to
# SQL_EDITOR_MAX_TIMEOUT_MS. The editor is allowlist-validated and scoped to
# the caller's site — see docs/SQL_EDITOR_SECURITY.md.
# SQL_EDITOR_TIMEOUT_MS=15000     # default: 15000
# SQL_EDITOR_MAX_TIMEOUT_MS=30000 # default: 30000

# ── Visitor privacy ──────────────────────────────────────────────
# How many days a visitor id survives without a return visit. The window slides
# on each visit, so a regular visitor is never re-counted mid-stream; it only
# elapses after this many days of no visits. Bounds how far back one visitor can
# be correlated. Set to 0 to disable rotation (ids then never expire).
# VISITOR_ID_TTL_DAYS=180         # default: 180

# How often the retention scheduler sweeps sites with an enabled retention
# policy. Sites without a policy are untouched. Set to 0 to disable the
# scheduler and run cleanup only via the API endpoint.
# RETENTION_INTERVAL_MS=21600000  # default: 21600000 (6 hours)

# ── PostgreSQL → DuckDB sync ─────────────────────────────────────
SYNC_INTERVAL_MS=60000
SYNC_BATCH_SIZE=5000
# SYNC_DEBOUNCE_MS=5000           # default: 5000

# ── Query cache TTLs (milliseconds) ──────────────────────────────
# CACHE_TTL_KPI_MS=30000          # default: 30000
# CACHE_TTL_REALTIME_MS=10000     # default: 10000
# CACHE_TTL_TRAFFIC_MS=60000      # default: 60000
# CACHE_TTL_PAGES_MS=60000        # default: 60000
# CACHE_TTL_GENERAL_MS=120000     # default: 120000
# CACHE_DEFAULT_TTL_MS=60000      # default: 60000
# CACHE_CLEANUP_INTERVAL_MS=300000 # default: 300000 (5 min)

# ── Pulse (AI analyst) — optional ────────────────────────────────
# Leave blank to let each user bring their own key in the UI. A server key
# here is used for users who have not supplied one.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_BASE_URL=             # override for proxies/self-hosted gateways
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# ASSISTANT_DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5   # default: claude-sonnet-5
# ASSISTANT_DEFAULT_MODEL_OPENAI=gpt-4o-mini          # default: gpt-4o-mini
# ASSISTANT_DEFAULT_MODEL_GEMINI=gemini-2.5-flash     # default: gemini-2.5-flash
# ASSISTANT_MAX_TOKENS=1500       # default: 1500
# ASSISTANT_MAX_HISTORY_TURNS=20  # default: 20
# ASSISTANT_RATE_LIMIT_OWN_KEY=30 # default: 30  (requests/hour, user's own key)
# ASSISTANT_RATE_LIMIT_SERVER_KEY=10 # default: 10 (requests/hour, server key)
# ASSISTANT_TOOL_MAX_ROWS=100     # default: 100
# ASSISTANT_TOOL_MAX_CHARS=20000  # default: 20000

# ── MCP server — optional ────────────────────────────────────────
# Exposes analytics to MCP clients (e.g. Claude Desktop). See docs/mcp-toolkit.md.
# MCP_TOKEN_EXPIRES_IN=365d       # default: 365d
# MCP_TOOL_MAX_ROWS=100           # default: 100
# MCP_SERVER_PATH=                # path to a local MCP server build
# MCP_SERVER_PACKAGE=             # or an npm package name
# MCP_TOOLKIT_DEMOS=              # set to 1 to expose demo endpoints (dev only)
# INSIGHTTRACK_API_URL=           # API URL the MCP server calls
# INSIGHTTRACK_TOKEN=             # token the MCP server authenticates with

# ── Sentry integration — optional ────────────────────────────────
# Per-site Sentry credentials are configured in the UI; these tune polling.
# SENTRY_POLL_INTERVAL_MS=300000  # default: 300000 (5 min)
# SENTRY_MAX_ISSUES=1000          # default: 1000
# SENTRY_ISSUES_PER_POLL=100      # default: 100
# SENTRY_POLL_CONCURRENCY=4       # default: 4
# SENTRY_TIMEOUT_MS=15000         # default: 15000
# SENTRY_STATS_PERIOD=30d         # default: 30d
# SENTRY_CADENCE_BASE_S=300       # default: 300    (backoff floor)
# SENTRY_CADENCE_MAX_S=3600       # default: 3600   (backoff ceiling)
# SENTRY_CADENCE_AUTH_FAIL_S=21600 # default: 21600 (retry delay after auth failure)

# ── Demo / seed data ─────────────────────────────────────────────
# DEMO_SITE_DOMAIN=hello.com      # default: hello.com

# ── S3 / R2 / MinIO cold storage (optional) ──────────────────────
# Leave all blank to use local Docker volumes only.
# Set S3_BUCKET + S3_ACCESS_KEY + S3_SECRET_KEY to enable cold archival.
#
# Cloudflare R2 example (zero egress cost — recommended):
#   S3_BUCKET=insighttrack-cold
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
# AWS S3 example:
#   S3_BUCKET=my-insighttrack-bucket
#   S3_REGION=us-east-1
#   (leave S3_ENDPOINT blank)
#
# MinIO self-hosted example:
#   S3_ENDPOINT=http://minio:9000
#   S3_USE_SSL=false

S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PREFIX=insighttrack
S3_USE_SSL=true
ARCHIVE_DAYS=30
ARCHIVE_TABLES=events,sessions
